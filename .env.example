# Proxmox VE API Credentials (for OpenTofu / Telmate/bpg provider)
PROXMOX_VE_ENDPOINT="https://pve.example.local:8006/"
PROXMOX_VE_USERNAME="root@pam"
PROXMOX_VE_API_TOKEN="USER@REALM!TOKENID=SECRET"
# Or if using user + password:
# PROXMOX_VE_PASSWORD=""

# OpenTofu Provider variables (depending on provider choice, e.g. bpg/proxmox or Telmate/proxmox)
# PM_API_URL="https://pve.example.local:8006/api2/json"
# PM_API_TOKEN_ID="root@pam!tokenid"
# PM_API_TOKEN_SECRET="xxxx-xxxx-xxxx-xxxx"

# Ansible Configuration
ANSIBLE_VAULT_PASSWORD_FILE=".vault_pass"
ANSIBLE_HOST_KEY_CHECKING="False"
