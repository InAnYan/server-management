[SERVICE]
    Flush         {{ fluentbit_flush_seconds }}
    Daemon        Off
    Log_Level     info
    Parsers_File  /etc/fluent-bit/parsers.conf

# Poll systemd journal logs
[INPUT]
    Name            systemd
    Tag             systemd.*
    Path            /var/log/journal
    Read_From_Tail  On

# Poll Docker container logs every second
[INPUT]
    Name             tail
    Tag              docker.*
    Path             /var/lib/docker/containers/*/*-json.log
    Parser           docker
    Refresh_Interval {{ fluentbit_poll_seconds }}
    Read_from_Head   False
    Skip_Long_Lines  On

[OUTPUT]
    Name            loki
    Match           *
    Host            {{ fluentbit_loki_host }}
    Port            {{ fluentbit_loki_port }}
    Labels          job=fluentbit, vm={{ inventory_hostname }}, env={{ inventory_hostname.split('-')[0] if '-' in inventory_hostname else 'core' }}
    Auto_Kubernetes_Labels Off
