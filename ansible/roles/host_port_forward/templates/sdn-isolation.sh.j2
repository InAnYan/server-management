#!/bin/sh
# Proxmox SDN inter-subnet isolation and database perimeter enforcement
# [impl->req~cross-environment-isolation~1]
# [impl->req~databases-isolated-from-internet~1]

set -e

case "$1" in
  apply)
    # Ensure custom chain exists and is clean
    iptables -N SDN-ISOLATION 2>/dev/null || iptables -F SDN-ISOLATION
    iptables -C FORWARD -j SDN-ISOLATION 2>/dev/null || iptables -I FORWARD 1 -j SDN-ISOLATION

    # 1. Database internet isolation (block outbound traffic to physical WAN uplink vmbr0)
    iptables -A SDN-ISOLATION -s 10.10.2.0/24 -o vmbr0 -j REJECT --reject-with icmp-admin-prohibited
    iptables -A SDN-ISOLATION -s 10.20.2.0/24 -o vmbr0 -j REJECT --reject-with icmp-admin-prohibited
    iptables -A SDN-ISOLATION -s 10.30.2.0/24 -o vmbr0 -j REJECT --reject-with icmp-admin-prohibited

    # 2. Cross-environment isolation (prevent dev and prod from contacting each other)
    iptables -A SDN-ISOLATION -s 10.20.0.0/15 -d 10.30.0.0/15 -j REJECT --reject-with icmp-admin-prohibited
    iptables -A SDN-ISOLATION -s 10.30.0.0/15 -d 10.20.0.0/15 -j REJECT --reject-with icmp-admin-prohibited
    ;;

  clear)
    iptables -D FORWARD -j SDN-ISOLATION 2>/dev/null || true
    iptables -F SDN-ISOLATION 2>/dev/null || true
    iptables -X SDN-ISOLATION 2>/dev/null || true
    ;;

  *)
    echo "Usage: $0 {apply|clear}"
    exit 1
    ;;
esac
