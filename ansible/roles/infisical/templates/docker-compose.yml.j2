---
# Docker Compose definition for Infisical Secret Manager
# [impl->req~configuration-ansible~1]
# [impl->req~in-ram-container-secrets~1]

services:
  infisical:
    image: "{{ infisical_image }}"
    container_name: "{{ infisical_container_name }}"
    restart: unless-stopped
    ports:
      - "{{ infisical_port }}:8080"
    env_file:
      - /dev/shm/infisical/infisical.env
    environment:
      - NODE_ENV=production
      - PORT=8080
      - SITE_URL=https://{{ infisical_domain }}
      - INFISICAL_TELEMETRY_ENABLED=false
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
