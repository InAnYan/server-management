proxmox_endpoint  = "https://proxmox.example.com:8006/"
proxmox_api_token = "terraform@pve!terraform_token=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
proxmox_insecure  = true
proxmox_node      = "pve-01"

# Feature flags for optional service VMs
enable_technitium = true
enable_redis_core = false
enable_redis_dev  = false
enable_redis_prod = false
enable_minio_core = false
enable_minio_dev  = false
enable_minio_prod = false
