[Unit]
Description=Proxmox SDN Inter-Subnet and Internet Isolation Enforcement
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/sdn-isolation apply
ExecStop=/usr/local/sbin/sdn-isolation clear

[Install]
WantedBy=multi-user.target
