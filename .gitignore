# Ansible inventory with real host IPs (local only - never commit)
ansible/inventory/hosts.ini
ansible/inventory/*.ini
!ansible/inventory/hosts.ini.example
!ansible/inventory/*.example
# Unencrypted Ansible secret files (never commit)
ansible/**/vault.yml
ansible/**/secrets.yml
*secrets.yml
*vault.yml
!*.example
