#!/usr/bin/env bash
#
# Pre-commit hook to prevent accidental secret commits
#

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "==> Running pre-commit secret detection..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# 1. Check for forbidden file names staged in git
FORBIDDEN_FILES=()

for FILE in $STAGED_FILES; do
    # Skip template / example files
    if [[ "$FILE" =~ \.example$ ]]; then
        continue
    fi

    # Check against forbidden patterns
    if [[ "$FILE" =~ \.tfvars$ ]] || \
       [[ "$FILE" =~ \.tfstate ]] || \
       [[ "$FILE" =~ (^|/)\.env($|\.) ]] || \
       [[ "$FILE" =~ (secrets|vault)\.ya?ml$ ]] || \
       [[ "$FILE" =~ \.vault_pass ]] || \
       [[ "$FILE" =~ id_(rsa|ed25519) ]] || \
       [[ "$FILE" =~ \.(pem|key)$ ]]; then
        FORBIDDEN_FILES+=("$FILE")
    fi
done

if [ ${#FORBIDDEN_FILES[@]} -gt 0 ]; then
    echo -e "${RED}[ERROR] Aborting commit! Forbidden sensitive files staged:${NC}"
    for F in "${FORBIDDEN_FILES[@]}"; do
        echo -e "  ${RED}- $F${NC}"
    done
    echo ""
    echo "Secrets and environment files must never be committed."
    echo "Unstage them using: git rm --cached <file>"
    exit 1
fi

# 2. Check staged content for known secret signatures
CONTENT_VIOLATIONS=0
DIFF=$(git diff --cached -U0)

check_pattern() {
    local PATTERN="$1"
    local DESC="$2"

    if echo "$DIFF" | grep -E "^\+" | grep -Ev "^\+\+\+" | grep -qEi "$PATTERN"; then
        echo -e "${RED}[ERROR] Potential secret detected ($DESC)!${NC}"
        CONTENT_VIOLATIONS=1
    fi
}

check_pattern "PVEAPIToken=[a-zA-Z0-9_\-]+![a-zA-Z0-9_\-]+=" "Proxmox API Token"
check_pattern "BEGIN (RSA|OPENSSH|DSA|EC|PGP)? *PRIVATE KEY" "Private Key Header"
check_pattern "AKIA[0-9A-Z]{16}" "AWS Access Key"
check_pattern "(ghp|gho|ghu|ghs|ghr)_[0-9a-zA-Z]{36}" "GitHub Token"

# 3. If gitleaks is installed locally, run it
if command -v gitleaks >/dev/null 2>&1; then
    echo "==> Running local gitleaks scan..."
    if ! gitleaks protect --staged --verbose; then
        echo -e "${RED}[ERROR] gitleaks detected secrets in staged changes!${NC}"
        CONTENT_VIOLATIONS=1
    fi
fi

if [ $CONTENT_VIOLATIONS -ne 0 ]; then
    echo -e "${RED}[ERROR] Commit aborted due to potential secrets in staged content.${NC}"
    echo "Please remove secrets or use dummy placeholders before committing."
    exit 1
fi

echo -e "${GREEN}✓ Secret detection check passed.${NC}"
exit 0
